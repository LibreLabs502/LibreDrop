# Referencia de variables para PRODUCCIÓN (Render + Neon + Vercel).
# En Render se cargan en el dashboard (Environment), no en un archivo.
# Este archivo sirve como plantilla y para probar la imagen Docker en local
# (copialo a `.env`, que está en .gitignore).

# ── Django ──────────────────────────────────────────────────────────────────
# Generala con: python -c "import secrets; print(secrets.token_urlsafe(64))"
# En render.yaml va con `sync: false`: la generás vos y la pegás en el dashboard
# (Render no genera secretos automáticamente con ese modo).
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
DEBUG=False

# Hosts permitidos. En Render, si no lo definís, se agrega
# RENDER_EXTERNAL_HOSTNAME automáticamente. Si usás dominio propio, ponelo acá;
# si usás el *.onrender.com, dejalo vacío.
# ALLOWED_HOST=api.tudominio.com

# ── Base de datos (Neon) ────────────────────────────────────────────────────
# Connection string completa de Neon. Incluí ?sslmode=require.
# Recomendado: usar el endpoint "pooled" (el host incluye "-pooler").
DATABASE_URL=postgresql://usuario:clave@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DB_SSL_REQUIRE=True

# ── Frontend (Vercel) → CORS ────────────────────────────────────────────────
# Origen exacto del frontend, con https:// y sin barra final.
CORS_ALLOWED_ORIGINS=https://tu-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://tu-app.vercel.app

# Variable del FRONTEND (se setea en Vercel, no acá):
#   VITE_API_URL=https://tu-api.onrender.com
# Sin barra final y sin /api. Lleva el prefijo VITE_ a propósito (el navegador
# la necesita); Vercel puede avisar que es "pública": es correcto.
# En Render aparece una CORS_ALLOWED_ORIGIN_REGEXES para los previews de Vercel
# (ver docs/despliegue.md).

# ── Cloudinary (imágenes) ───────────────────────────────────────────────────
# La API key debe tener rol UPLOADER (o Admin). Si es solo "Delivery", las
# subidas fallan con 500 aunque el ping/lectura funcionen.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Opcional ────────────────────────────────────────────────────────────────
# RENDER_EXTERNAL_HOSTNAME (lo setea Render solo)
# WEB_CONCURRENCY=3
# GUNICORN_TIMEOUT=60
# SECURE_SSL_REDIRECT=True
