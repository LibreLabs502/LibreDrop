# Referencia de variables para PRODUCCIÓN (Render + Neon + Vercel).
# En Render se cargan en el dashboard (Environment), no en un archivo.
# Este archivo sirve como plantilla y para probar la imagen Docker en local
# (copialo a `.env`, que está en .gitignore).

# ── Django ──────────────────────────────────────────────────────────────────
# Generá uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
# En Render usá `generateValue: true` (ver render.yaml).
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
DEBUG=False

# Hosts permitidos. En Render, si no lo definís, se agrega
# RENDER_EXTERNAL_HOSTNAME automáticamente. Si usás dominio propio, ponelo acá.
ALLOWED_HOST=api.tudominio.com

# ── Base de datos (Neon) ────────────────────────────────────────────────────
# Connection string completa de Neon. Incluí ?sslmode=require.
# Recomendado: usar el endpoint "pooled" (el host incluye "-pooler").
DATABASE_URL=postgresql://usuario:clave@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DB_SSL_REQUIRE=True

# ── Frontend (Vercel) → CORS ────────────────────────────────────────────────
# Origen exacto del frontend, con https:// y sin barra final.
CORS_ALLOWED_ORIGINS=https://tu-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://tu-app.vercel.app

# ── Cloudinary (imágenes) ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Opcional ────────────────────────────────────────────────────────────────
# RENDER_EXTERNAL_HOSTNAME (lo setea Render solo)
# WEB_CONCURRENCY=3
# GUNICORN_TIMEOUT=60
# SECURE_SSL_REDIRECT=True
