# Copiá este archivo a `.env` (en la raíz del repo) y completá los valores.
# `.env` está en .gitignore: nunca se sube al repo.

# ── Postgres (contenedor `db`, base nueva y vacía) ──────────────────────────
DB_NAME=libredrop
DB_USER=libredrop
DB_PASSWORD=cambia_esto_por_una_clave_larga_y_aleatoria

# ── Django ──────────────────────────────────────────────────────────────────
# Generá uno con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
DEBUG=False
# Hosts permitidos (Host header). Incluí el dominio del API y localhost.
ALLOWED_HOST=api.tudominio.com,localhost,127.0.0.1

# ── Dominio del backend ─────────────────────────────────────────────────────
# Debe tener un registro DNS tipo A apuntando a la IP de la VPS.
# Caddy saca el certificado HTTPS de este dominio automáticamente.
DOMAIN=api.tudominio.com

# ── Frontend (Vercel) → CORS ────────────────────────────────────────────────
# El origen exacto donde vive el frontend, con https:// y sin barra final.
CORS_ALLOWED_ORIGINS=https://tu-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://tu-app.vercel.app

# ── Cloudinary (imágenes) ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Opcional ────────────────────────────────────────────────────────────────
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=60
# SECURE_SSL_REDIRECT=True
